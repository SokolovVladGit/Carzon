# --------------------------------------------------------------------
# Carzon Flutter — CLIENT-SAFE template (commit-safe placeholders only)
# --------------------------------------------------------------------
#
# Copy to `.env.client` (gitignored) and fill in real client-safe values:
#
#     cp .env.client.example .env.client
#     # edit .env.client
#     flutter run --dart-define-from-file=.env.client
#
# This file is NOT a Flutter asset. Flutter reads keys at compile time via
# `--dart-define-from-file`, which inlines values into the binary.
#
# NEVER add server-only secrets here, including:
#   SUPABASE_SERVICE_ROLE_KEY, FCM_* server keys, CARZON_PROCESS_*_SECRET,
#   Firebase Admin private keys, VIN provider API keys, or private key material.
# Those belong in Supabase Edge Function secrets, Supabase Vault, or your
# shell only (e.g. manual curl smoke), never in Flutter config.
# --------------------------------------------------------------------

# Required
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional — recommended for mobile release builds (password-reset deep link).
# Must match Supabase Dashboard → Auth → Redirect URLs and platform intent filters.
# Example: carzon://auth-callback
SUPABASE_PASSWORD_RESET_REDIRECT_URL=
# Canonical public legal/support values. These defaults are also compiled into
# the app and may be overridden for another owner-controlled production host.
CARZON_PRIVACY_POLICY_URL=https://carzon-legal.netlify.app/privacy/
CARZON_TERMS_OF_SERVICE_URL=https://carzon-legal.netlify.app/terms/
CARZON_SUPPORT_URL=https://carzon-legal.netlify.app/support/
CARZON_PRIVACY_CHOICES_URL=https://carzon-legal.netlify.app/privacy-choices/
CARZON_SUPPORT_EMAIL=carzonsupport@gmail.com
# Optional legacy secondary moderation inbox. Native listing reports do not
# depend on this value.
CARZON_REPORT_EMAIL=
# OPTIONAL FOR MVP — leave empty until CARZON owns a real public listing page
# or universal-link surface. When empty, the listing Share action is hidden.
# Must be a production HTTPS base when supplied; never use the legal Netlify
# site, localhost, or an example/placeholder hostname.
CARZON_LISTING_SHARE_BASE_URL=
# Set true for real-device push QA; requires Firebase android/app/google-services.json
# and ios/Runner/GoogleService-Info.plist — see docs/mobile_push_setup.md
PUSH_NOTIFICATIONS_ENABLED=false
