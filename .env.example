SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional. When set, password-reset / email-confirmation emails
# deep-link to this URL. The default app scheme is registered in
# Android's AndroidManifest.xml (intent-filter) and iOS's Info.plist
# (CFBundleURLTypes); it must also be allow-listed in the Supabase
# dashboard under Authentication → URL Configuration → Redirect URLs.
# Leave empty to use the Supabase project's default Site URL.
SUPABASE_PASSWORD_RESET_REDIRECT_URL=carzon://auth-callback

# Optional. Destination for the in-app "Report listing" mailto action
# on the listing details page. When unset/empty, the Report action is
# hidden entirely (the app must NOT synthesize a fake address). The
# value below is a placeholder — production deployments must replace
# it with the real ops/moderation inbox.
CARZON_REPORT_EMAIL=reports@example.com

# Optional. When true/1/yes/on, initializes the Firebase client and may
# register FCM device tokens with Supabase (requires migrations
# through notification_preferences_and_push_tokens, real Firebase
# platform config, signed-in user, and OS notification permission).
# Hosted message push additionally requires Edge process-message-notifications,
# scheduler (Phase 3E), and successful real-device FCM/APNs smoke — not
# declared fully live until that passes. Default remains false when unset.
PUSH_NOTIFICATIONS_ENABLED=false

# --- Not used by the Flutter app (Env does not read this) ---
# Optional for local shell scripts / curl only. Must match:
#   • Edge Function secret CARZON_PROCESS_MESSAGE_NOTIFICATIONS_SECRET
#   • Vault secret VALUE for name carzon_process_message_notifications_secret
# Never commit a real value. See docs/ops_message_notifications.md
#CARZON_PROCESS_MESSAGE_NOTIFICATIONS_SECRET=
