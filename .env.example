SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional. When set, password-reset / email-confirmation emails
# deep-link to this URL. The default app scheme is registered in
# Android's AndroidManifest.xml (intent-filter) and iOS's Info.plist
# (CFBundleURLTypes); it must also be allow-listed in the Supabase
# dashboard under Authentication → URL Configuration → Redirect URLs.
# Leave empty to use the Supabase project's default Site URL.
SUPABASE_PASSWORD_RESET_REDIRECT_URL=carzon://auth-callback

# Optional. Destination for the in-app "Report listing" mailto action
# on the listing details page. When unset/empty, the Report action is
# hidden entirely (the app must NOT synthesize a fake address). The
# value below is a placeholder — production deployments must replace
# it with the real ops/moderation inbox.
CARZON_REPORT_EMAIL=reports@example.com
